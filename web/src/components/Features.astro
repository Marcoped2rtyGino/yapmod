---
const features = [
  {
    title: "Open source",
    body: "Everything we build is public. Read it, report what breaks, and help decide what ships next.",
    icon: `<path d="M29 11l-8 26M14 17L6 24l8 7M34 17l8 7-8 7"></path>`,
  },
  {
    title: "A real desktop app",
    body: "yapmod has its own window, icon and menu bar. No browser tab, no distractions.",
    icon: `<rect x="5" y="8" width="38" height="26" rx="5"></rect><path d="M17 42h14M24 34v8"></path>`,
  },
  {
    title: "Every platform",
    body: "Windows, macOS and Linux. One app, whichever computer you call home.",
    icon: `<circle cx="24" cy="24" r="17"></circle><path d="M7 24h34M24 7c-9 9-9 25 0 34M24 7c9 9 9 25 0 34"></path>`,
  },
];
---

<section class="sec" id="why">
  <div class="wrap">
    <h2>Its own app, open to everyone.</h2>
    <p class="sub">
      yapmod gives Yapper a dedicated desktop home and keeps the whole project public, so the
      community can shape it.
    </p>

    <div class="cols">
      {
        features.map((feature) => (
          <div class="col">
            <svg
              viewBox="0 0 48 48"
              fill="none"
              stroke="url(#gg)"
              stroke-width="3.2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <defs>
                <lineargradient id="gg" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0" stop-color="#f67567" />
                  <stop offset=".55" stop-color="#ff8a70" />
                  <stop offset="1" stop-color="#ffb25f" />
                </lineargradient>
              </defs>
              <Fragment set:html={feature.icon} />
            </svg>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
