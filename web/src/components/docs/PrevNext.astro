---
import { docUrl } from "../../lib/docs";
import type { DocEntry } from "../../lib/docs";

interface Props {
  prev?: DocEntry;
  next?: DocEntry;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="pn" aria-label="Documentation pages">
      {prev ? (
        <a href={docUrl(prev.id)} rel="prev">
          <small>Previous</small>
          {prev.data.title}
        </a>
      ) : (
        <span />
      )}
      {next ? (
        <a href={docUrl(next.id)} rel="next">
          <small>Next</small>
          {next.data.title}
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .pn {
    display: flex;
    justify-content: space-between;
    gap: 14px;
    margin-top: 64px;
    padding-top: 26px;
    border-top: 1.5px solid var(--line);
  }

  a {
    flex: 1;
    padding: 16px 20px;
    border: 1.5px solid var(--line);
    border-radius: 14px;
    text-decoration: none;
    color: var(--t);
    background: var(--s);
  }

  a:hover {
    border-color: var(--accent);
  }

  small {
    display: block;
    color: var(--m);
    font-size: 13px;
  }

  a:last-child {
    text-align: right;
  }

  @media (max-width: 560px) {
    .pn {
      flex-direction: column;
    }

    a:last-child {
      text-align: left;
    }
  }
</style>
