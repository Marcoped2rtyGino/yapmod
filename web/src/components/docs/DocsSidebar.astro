---
import { docUrl, groupDocs } from "../../lib/docs";
import type { DocEntry } from "../../lib/docs";

interface Props {
  docs: DocEntry[];
  current: string;
}

const { docs, current } = Astro.props;
const groups = groupDocs(docs);
---

<aside id="docs-sidebar">
  <div class="search">
    <button id="docs-search" type="button" aria-label="Search the docs (Command K)">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="M16.5 16.5 21 21"></path>
      </svg>
      <span>Search the docs</span>
      <kbd class="search-hint" aria-hidden="true">⌘K</kbd>
    </button>
  </div>

  <nav aria-label="Documentation">
    <ul class="overview">
      <li>
        <a
          href={docUrl("index")}
          class:list={{ on: current === "index" }}
          aria-current={current === "index" ? "page" : undefined}
          data-title="overview"
          data-description="everything about yapmod at a glance"
        >
          Overview
        </a>
      </li>
    </ul>

    {
      [...groups.entries()].map(([group, entries]) => (
        <>
          <h4>{group}</h4>
          <ul>
            {entries.map((doc) => (
              <li>
                <a
                  href={docUrl(doc.id)}
                  class:list={{ on: doc.id === current }}
                  aria-current={doc.id === current ? "page" : undefined}
                  data-title={doc.data.title.toLowerCase()}
                  data-description={(doc.data.description ?? "").toLowerCase()}
                >
                  {doc.data.title}
                </a>
              </li>
            ))}
          </ul>
        </>
      ))
    }
  </nav>
</aside>
<style>
  aside {
    position: sticky;
    top: 69px;
    align-self: start;
    height: calc(100vh - 69px);
    overflow-y: auto;
    padding: 24px 18px 48px 22px;
    border-right: 1.5px solid var(--line);
  }

  .search {
    position: relative;
    margin-bottom: 18px;
  }

  .search button {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1.5px solid var(--line);
    background: var(--s);
    color: var(--m);
    font: 15px Figtree, sans-serif;
    cursor: pointer;
    text-align: left;
  }

  .search button:hover {
    border-color: var(--accent);
    color: var(--t);
  }

  .search button svg {
    width: 16px;
    height: 16px;
    flex: none;
  }

  .search button span {
    flex: 1;
  }

  .search-hint {
    padding: 2px 6px;
    border: 1.5px solid var(--line);
    border-radius: 6px;
    font: 600 11px Figtree, sans-serif;
    color: var(--m);
    white-space: nowrap;
  }

  h4 {
    margin: 20px 0 6px;
    font: 700 12px Figtree, sans-serif;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--m);
  }

  .overview {
    margin-bottom: 8px;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  aside a {
    display: block;
    padding: 6px 12px;
    margin-left: -12px;
    border-radius: 9px;
    color: var(--m);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
  }

  aside a:hover {
    color: var(--t);
  }

  aside a.on {
    background: var(--accent-soft);
    color: var(--t);
    font-weight: 600;
  }

  .hidden-by-search {
    display: none;
  }

  @media (max-width: 900px) {
    aside {
      position: static;
      height: auto;
      border-right: 0;
      border-bottom: 1.5px solid var(--line);
      padding: 18px 20px;
      display: none;
    }

    aside.open {
      display: block;
    }
  }
</style>
