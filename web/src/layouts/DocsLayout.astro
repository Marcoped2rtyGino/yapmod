---
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import DocsHeader from "../components/docs/DocsHeader.astro";
import DocsSidebar from "../components/docs/DocsSidebar.astro";
import DocsToc from "../components/docs/DocsToc.astro";
import PrevNext from "../components/docs/PrevNext.astro";
import Footer from "../components/Footer.astro";
import SearchPalette from "../components/docs/SearchPalette.astro";
import { sortDocs } from "../lib/docs";
import "../styles/docs.css";

interface Props {
  title: string;
  description?: string;
  eyebrow?: string;
  current?: string;
  headings?: { depth: number; slug: string; text: string }[];
}

const { title, description, eyebrow, current = "", headings = [] } = Astro.props;

const docs = sortDocs(await getCollection("docs"));
const index = docs.findIndex((doc) => doc.id === current);

// The overview page is not part of the collection, so it links to the first
// document and has no previous page.
const prev = index > 0 ? docs[index - 1] : undefined;
const next =
  current === "index" ? docs[0] : index !== -1 && index < docs.length - 1 ? docs[index + 1] : undefined;

const pageTitle = current === "index" ? "Documentation" : `${title} – yapmod docs`;
const pageDescription =
  description ?? `Documentation for yapmod, the open-source desktop app for Yapper.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <DocsHeader />

  <div class="docs-layout">
    <DocsSidebar docs={docs} current={current} />

    <main id="main" class="docs-main">
      <article class="prose">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1>{title}</h1>
        {description && <p class="lead">{description}</p>}
        <slot />
      </article>

      <PrevNext prev={prev} next={next} />
    </main>

    <DocsToc headings={headings} />
  </div>

  <Footer />

  <SearchPalette />
</BaseLayout>

<script>
  // Copy buttons on every code block.
  for (const pre of document.querySelectorAll<HTMLElement>(".prose pre")) {
    if (pre.parentElement?.classList.contains("code-block")) continue;

    const wrapper = document.createElement("div");
    wrapper.className = "code-block";
    pre.replaceWith(wrapper);
    wrapper.append(pre);

    const button = document.createElement("button");
    button.type = "button";
    button.className = "copy-btn";
    button.textContent = "Copy";
    button.setAttribute("aria-label", "Copy the code to the clipboard");

    button.addEventListener("click", async () => {
      const code = pre.querySelector("code")?.textContent ?? pre.textContent ?? "";

      try {
        await navigator.clipboard.writeText(code);
        button.textContent = "Copied";
      } catch {
        button.textContent = "Press Ctrl+C";
      }

      setTimeout(() => (button.textContent = "Copy"), 1500);
    });

    wrapper.append(button);
  }

  // The sidebar toggles on small screens.
  const toggle = document.getElementById("docs-menu");
  const sidebar = document.getElementById("docs-sidebar");

  toggle?.addEventListener("click", () => {
    const open = sidebar?.classList.toggle("open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>
