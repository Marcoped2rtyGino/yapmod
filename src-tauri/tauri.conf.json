{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yapmod",
  "version": "0.2.0",
  "identifier": "io.ilyeshdz.yapmod",
  "build": {
    "beforeDevCommand": "pnpm injection:build",
    "devUrl": "http://yapper.website/",
    "beforeBuildCommand": "pnpm injection:build",
    "frontendDist": "https://yapper.website/"
  },
  "app": {
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./Entitlements.plist"
    }
  }
}
